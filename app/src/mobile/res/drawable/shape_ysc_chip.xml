<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ysc_accent_soft" />
                    <corners android:radius="@dimen/ysc_chip_radius" />
                    <stroke android:width="1dp" android:color="@color/ysc_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ysc_chip" />
                    <corners android:radius="@dimen/ysc_chip_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
